# ─────────────────────────────────────────────────────────────────────────────
# Media Service — Environment Variables
# Copy to .env and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/MediaDB?sslmode=require"

# Google / YouTube Data API v3 OAuth2 Credentials
YOUTUBE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
YOUTUBE_CLIENT_SECRET="your-google-client-secret"
YOUTUBE_REFRESH_TOKEN="your-oauth2-refresh-token"

# HTTP and gRPC Ports
PORT=5003
GRPC_PORT=5004

# RabbitMQ Event Broker (for publishing VideoUploaded events)
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"
