# ─────────────────────────────────────────────────────────────────────────────
# Web App (Next.js) — Environment Variables
# Copy to .env.local and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# Internal API Gateway URL — used by Server Components / API Routes for SSR fetches
API_GATEWAY_URL=http://localhost:3333

# Client-side API URL (if needed for direct client fetching)
NEXT_PUBLIC_API_URL=http://localhost:3333
