# ─────────────────────────────────────────────────────────────────────────────
# User Service — Environment Variables
# Copy to .env and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/UserDB?sslmode=require"

# gRPC Server Port (default: 5001)
GRPC_PORT=5001
