generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model UserCredentials {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         String   @default("student")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
