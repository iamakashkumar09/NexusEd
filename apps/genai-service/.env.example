# ─────────────────────────────────────────────────────────────────────────────
# GenAI Service — Environment Variables
# Copy to .env and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# Application
APP_NAME=nexused-genai-service
APP_ENV=development           # development | production
APP_PORT=8001
GRPC_PORT=50054

# ─── LLM Configuration ────────────────────────────────────────────────────────
# Provider: "groq" | "gemini" | "openai" | "ollama"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Groq (default — obtain free API key at https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini (optional)
GOOGLE_API_KEY=your-google-api-key-here

# OpenAI (optional)
OPENAI_API_KEY=your-openai-api-key-here

# Ollama (local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Embeddings (Hugging Face Inference API) ──────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
HUGGING_FACE_API=hf_your_hugging_face_token_here

# ─── Qdrant Cloud / Vector Store ──────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION_NAME=nexused_lectures

# ─── RabbitMQ Event Broker ───────────────────────────────────────────────────
RABBITMQ_URL=amqps://user:password@hostname/vhost

# Queue names
VIDEO_UPLOADED_QUEUE=video.uploaded
AI_PROCESSING_COMPLETE_QUEUE=ai.processing.complete

# ─── Ingestion Settings ───────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=5
