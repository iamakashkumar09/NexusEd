# ─────────────────────────────────────────────────────────────────────────────
# Auth Service — Environment Variables
# Copy to .env and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/AuthDB?sslmode=require"

# JWT Secret & Expiration
JWT_SECRET="super-secret-local-jwt-key"

# SMTP Email Configuration (for OTP verification and password reset)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-email-app-password"

# gRPC Microservices
USER_SERVICE_URL="0.0.0.0:5001"
