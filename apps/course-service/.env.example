# ─────────────────────────────────────────────────────────────────────────────
# Course Service — Environment Variables
# Copy to .env and configure for your environment
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Connection URL (e.g. Neon, Supabase, or Local Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/CourseDB?sslmode=require"

# RabbitMQ Event Broker (CloudAMQP or local instance)
RABBITMQ_URL="amqp://guest:guest@localhost:5672/"

# gRPC Server Port (default: 5002)
GRPC_PORT=5002
